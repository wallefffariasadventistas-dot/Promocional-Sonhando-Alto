# Credencial do Firebase (Firestore). Duas formas de configurar — escolha uma:
#
# Opção A (uma variável só): gere o arquivo .json em Firebase Console →
# Configurações do projeto → Contas de serviço → "Gerar nova chave privada",
# depois rode `npm run encode-firebase-key -- caminho/do/arquivo.json` e cole
# o resultado aqui:
FIREBASE_SERVICE_ACCOUNT_BASE64=
#
# Opção B (sem rodar nenhum comando): copie os três campos direto do mesmo
# arquivo .json para as variáveis abaixo (deixe a Opção A em branco):
#   FIREBASE_PROJECT_ID=project_id do arquivo
#   FIREBASE_CLIENT_EMAIL=client_email do arquivo
#   FIREBASE_PRIVATE_KEY=private_key do arquivo (com as próprias "\n")
#
# Deixe tudo em branco para desenvolvimento local sem Firebase: os leads são
# salvos automaticamente em um arquivo temporário até você configurar isto.

# Segredo usado para assinar o cookie (JWT) de sessão do admin.
# Gere um valor aleatório forte, por exemplo com: openssl rand -hex 32
SESSION_SECRET=troque-este-valor-por-um-segredo-aleatorio

# Login do painel: e-mail e senha são gerenciados pelo Firebase Authentication
# (Firebase Console → Authentication → Sign-in method → ative "E-mail/senha",
# depois em "Users" → "Add user" para cada pessoa que pode acessar o painel).
#
# Opcional: restringe quem pode entrar mesmo tendo conta no Firebase Auth do
# projeto. Deixe em branco para permitir qualquer usuário cadastrado lá.
ADMIN_EMAILS=
