# Porta em que o servidor vai rodar
PORT=3000

# Ambiente: "development" ou "production"
NODE_ENV=development

# Segredo usado para assinar o cookie de sessão do admin.
# Gere um valor aleatório forte, por exemplo com: openssl rand -hex 32
SESSION_SECRET=troque-este-valor-por-um-segredo-aleatorio

# Usuário do painel administrativo
ADMIN_USERNAME=admin

# Hash bcrypt da senha do administrador.
# Gere com: npm run hash-password -- "suaSenhaForte"
ADMIN_PASSWORD_HASH=
