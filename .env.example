# Conexão com o Postgres (Neon). Depois de conectar um banco ao projeto
# no dashboard do Vercel (aba Storage), rode `vercel env pull .env.local`
# para preencher isto automaticamente — não edite manualmente em produção.
# O Vercel injeta DATABASE_URL e/ou POSTGRES_URL; qualquer um dos dois funciona.
# Deixe em branco para desenvolvimento local sem banco: os leads são salvos
# automaticamente em um arquivo temporário até você conectar um Postgres.
DATABASE_URL=

# Segredo usado para assinar o cookie (JWT) de sessão do admin.
# Gere um valor aleatório forte, por exemplo com: openssl rand -hex 32
SESSION_SECRET=troque-este-valor-por-um-segredo-aleatorio

# Usuário do painel administrativo
ADMIN_USERNAME=admin

# Hash bcrypt da senha do administrador.
# Gere com: npm run hash-password -- "suaSenhaForte"
ADMIN_PASSWORD_HASH=
