# Credencial do Firebase (Firestore), em base64.
# Como gerar: Firebase Console → Configurações do projeto → Contas de serviço
# → "Gerar nova chave privada" (baixa um .json), depois rode:
#   node -e "console.log(Buffer.from(require('fs').readFileSync('caminho/do/arquivo.json')).toString('base64'))"
# e cole o resultado aqui (uma linha só).
# Deixe em branco para desenvolvimento local sem Firebase: os leads são salvos
# automaticamente em um arquivo temporário até você configurar isto.
FIREBASE_SERVICE_ACCOUNT_BASE64=

# Segredo usado para assinar o cookie (JWT) de sessão do admin.
# Gere um valor aleatório forte, por exemplo com: openssl rand -hex 32
SESSION_SECRET=troque-este-valor-por-um-segredo-aleatorio

# Usuário do painel administrativo
ADMIN_USERNAME=admin

# Hash bcrypt da senha do administrador.
# Gere com: npm run hash-password -- "suaSenhaForte"
ADMIN_PASSWORD_HASH=
